# Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Numeric User ID of Super Admin (from @userinfobot)
ADMIN_ID=123456789

# Telegram Channel & Support (Optional)
CHANNEL_USERNAME=@YourChannel
CHANNEL_URL=https://t.me/YourChannel
SUPPORT_BOT_USERNAME=@YourSupportBot
SUPPORT_BOT_URL=https://t.me/YourSupportBot

# Card Details for Manual Card-to-Card Payment (Optional - can also be set inside bot)
DEFAULT_CARD_NUMBER=6037-0000-0000-0000
